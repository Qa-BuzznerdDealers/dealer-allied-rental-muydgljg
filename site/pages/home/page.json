{
  "version": 2,
  "nodes": [
    {
      "id": "hero",
      "type": "hero",
      "props": {
        "headingLevel": 1,
        "eyebrow": "Rentals",
        "headline": "Truck & trailer rentals",
        "subhead": "Browse available rental units, then request your dates. The branch confirms availability and rate.",
        "showSearch": true,
        "ctas": [
          {
            "ctaId": "browse-inventory"
          },
          {
            "ctaId": "request-rental",
            "style": "secondary"
          }
        ]
      }
    },
    {
      "id": "rental-search",
      "type": "widget",
      "props": {
        "widget": "inventory-search",
        "config": {
          "heading": "Search rental inventory"
        }
      }
    },
    {
      "id": "rental-units",
      "type": "widget",
      "props": {
        "widget": "inventory-carousel",
        "config": {
          "heading": "Available rentals",
          "limit": 8
        }
      }
    },
    {
      "id": "reserve",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7,
        "background": "paper",
        "anchor": "reserve"
      },
      "children": [
        {
          "id": "reserve-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "start",
            "stackOn": "mobile"
          },
          "children": [
            {
              "id": "reserve-copy",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "reserve-h",
                  "type": "heading",
                  "props": {
                    "text": "Reserve a rental",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "reserve-t",
                  "type": "text",
                  "props": {
                    "text": "Tell us the dates and where it is going. Nothing is booked until the branch confirms."
                  }
                },
                {
                  "id": "reserve-phone",
                  "type": "widget",
                  "props": {
                    "widget": "phone-numbers"
                  }
                }
              ]
            },
            {
              "id": "reserve-form-col",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "reserve-form",
                  "type": "form",
                  "props": {
                    "formId": "rental-request"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
